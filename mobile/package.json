{
  "name": "hantibink-app",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "start:clear": "expo start --dev-client --clear",
    "start:tunnel": "expo start --dev-client --tunnel --clear",
    "start:prod-api": "test -f .env.production && cp .env.production .env.development.local || (echo '⚠️  .env.production not found! Copy .env.production.example to .env.production and configure it.' && exit 1); expo start --clear && rm -f .env.development.local",
    "start:prod-api:tunnel": "test -f .env.production && cp .env.production .env.development.local || (echo '⚠️  .env.production not found! Copy .env.production.example to .env.production and configure it.' && exit 1); expo start --tunnel --clear && rm -f .env.development.local",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "build:all": "eas build --platform all",
    "submit:android": "eas submit --platform android",
    "submit:ios": "eas submit --platform ios",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "format": "npm run prettier:fix && npm run lint:fix",
    "clean": "expo install --fix && npm run start:clear",
    "deps:check": "npm outdated",
    "deps:update": "npm update",
    "security:audit": "npm audit",
    "security:fix": "npm audit fix",
    "bundle:analyze": "npx expo export --dump-assetmap",
    "doctor": "npx expo-doctor"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.6",
    "@ptomasroos/react-native-multi-slider": "^2.2.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/slider": "^5.0.1",
    "@react-navigation/bottom-tabs": "^7.4.6",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/stack": "^7.4.7",
    "babel-preset-expo": "~54.0.0",
    "expo": "~54.0.0",
    "expo-auth-session": "~7.0.9",
    "expo-blur": "~15.0.7",
    "expo-crypto": "~15.0.7",
    "expo-dev-client": "~6.0.18",
    "expo-device": "~8.0.9",
    "expo-haptics": "~15.0.8",
    "expo-image-manipulator": "~14.0.7",
    "expo-image-picker": "~17.0.8",
    "expo-linear-gradient": "~15.0.7",
    "expo-location": "~19.0.7",
    "expo-notifications": "~0.32.13",
    "expo-status-bar": "~3.0.8",
    "expo-updates": "~29.0.13",
    "expo-web-browser": "~15.0.9",
    "firebase": "^12.1.0",
    "react": "19.1.0",
    "react-hook-form": "^7.62.0",
    "react-native": "0.81.5",
    "react-native-draggable-grid": "^2.2.2",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "^1.11.0",
    "react-native-google-places-autocomplete": "^2.5.7",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-paper": "^5.14.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "rn-emoji-keyboard": "^1.7.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.3",
    "@babel/eslint-parser": "^7.28.0",
    "@babel/plugin-transform-template-literals": "^7.27.1",
    "@expo/metro-config": "~54.0.2",
    "@react-native-community/eslint-config": "^3.2.0",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-native": "^5.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "metro": "^0.83.1",
    "prettier": "^3.6.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "private": true
}
