# Environment Configuration for Hantibink API

# ===== SERVER CONFIGURATION =====
NODE_ENV=development
PORT=4242
HOST=localhost

# ===== DATABASE CONFIGURATION =====
# IMPORTANT: Use separate databases for dev, test, and prod to prevent data loss!
#
# Development database (local PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/hantibink_dev"
DIRECT_URL="postgresql://username:password@localhost:5432/hantibink_dev"
#
# Test database (REQUIRED for running tests - must be different from DATABASE_URL)
TEST_DATABASE_URL="postgresql://username:password@localhost:5432/hantibink_test"
TEST_DIRECT_URL="postgresql://username:password@localhost:5432/hantibink_test"
#
# Shadow database (for Prisma migrations)
SHADOW_DATABASE_URL="postgresql://username:password@localhost:5432/hantibink_shadow"
#
# Production database is configured in Cloud Run environment variables
# NEVER put production credentials in this file
#
REDIS_URL="redis://localhost:6379"

# ===== FIREBASE CONFIGURATION =====
# Firebase Admin SDK - Download service account key from Firebase Console
FIREBASE_PROJECT_ID=hantibink
FIREBASE_PRIVATE_KEY_ID=your_private_key_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@hantibink.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your_client_id

# ===== JWT CONFIGURATION =====
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_random
JWT_EXPIRES_IN=7d

# ===== OAUTH CONFIGURATION =====
# Google OAuth - Get from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ===== ADMIN CONFIGURATION =====
ADMIN_EMAIL=admin@example.com

# ===== API CONFIGURATION =====
API_VERSION=v1
CORS_ORIGIN=http://localhost:19006,exp://192.168.1.100:19000
RATE_LIMIT_MAX_REQUESTS=100

# ===== STRIPE CONFIGURATION =====
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ===== LOGGING CONFIGURATION =====
LOG_LEVEL=info
LOG_FILE=logs/app.log
